# Manual reference only: the application does NOT automatically load this file.
# Export variables in your shell before starting the local application.
# Replace blank values locally. Never commit credentials.

# Required BEFORE the first server start; distinct from provider API keys.
STT_ADMIN_PASSWORD=

# Choose Google API-key authentication (one key is sufficient):
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OR leave Google API keys unset and use your own Vertex project + location
# with Application Default Credentials. No author project is supplied.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json

# Optional per-role provider choices in the admin UI:
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# InternetContext grounding still requires Google authentication.